__version__: str
from typing import List, Optional
from os import PathLike
from enum import Enum  # <-- Важно импортировать Enum

# --- НОВЫЕ КЛАССЫ, ВИДИМЫЕ В PYTHON ---

class HorizAlignment(Enum):
    """Горизонтальное выравнивание."""
    Left: "HorizAlignment"
    Center: "HorizAlignment"
    Right: "HorizAlignment"
    Fill: "HorizAlignment"
    Justify: "HorizAlignment"

class VertAlignment(Enum):
    """Вертикальное выравнивание."""
    Top: "VertAlignment"
    Center: "VertAlignment"
    Bottom: "VertAlignment"
    Justify: "VertAlignment"

class AlignSpec:
    """Спецификация выравнивания для ячейки."""
    def __init__(
        self,
        horiz: Optional[HorizAlignment] = None,
        vert: Optional[VertAlignment] = None,
        wrap: bool = False,
    ) -> None: ...

def scan_excel(path: str | PathLike[str]) -> List[str]: ...
def create_excel(path: str | PathLike[str], sheet_name: str = "Sheet1") -> None: ...

class Editor:
    def __init__(self, path: str | PathLike[str], sheet_name: Optional[str] = None) -> None: ...
    @staticmethod
    def create(path: str | PathLike[str], sheet_name: str = "Sheet1") -> "Editor": ...
    @staticmethod
    def open(path: str | PathLike[str], sheet_name: Optional[str] = None) -> "Editor": ...
    def clone(self) -> "Editor": ...
    def uses_1904_dates(self) -> bool: ...
    def write_typed_rows(self, start: str, rows: object) -> None: ...
    def force_column_formats(self, formats: list[tuple[int, str]]) -> None: ...
    def append_row(self, cells: List[str]) -> None: ...
    def append_table_at(self, cells: List[List[str]], start_cell: str) -> None: ...
    def save(self, path: str | PathLike[str] | None = None) -> None: ...
    def last_row_index(self, col_name: str) -> int: ...
    def last_rows_index(self, col_name: str) -> List[int]: ...
    def add_worksheet(self, sheet_name: str) -> None: ...
    def add_worksheet_at(self, sheet_name: str, index: int) -> None: ...
    def with_worksheet(self, sheet_name: str) -> None: ...
    def delete_worksheet(self, sheet_name: str) -> None: ...
    def rename_worksheet(self, old_name: str, new_name: str) -> None: ...
    def set_number_format(self, range: str, fmt: str) -> None: ...
    def set_fill(self, range: str, rgb: str) -> None: ...
    def merge_cells(self, range: str) -> None: ...
    def set_border(self, range: str, style: str) -> None: ...
    
    # --- ОБНОВЛЕННЫЙ МЕТОД ---
    def set_font(
        self,
        range: str, 
        name: str, 
        size: float, 
        bold: bool = False, 
        italic: bool = False, 
        align: Optional[AlignSpec] = None  # <-- Добавлен опциональный аргумент
    ) -> None: ...
    
    # --- НОВЫЙ МЕТОД ---
    def set_alignment(self, range: str, spec: AlignSpec) -> None: ...

    def set_cell(self, coords: str, cell: str) -> None: ...
    def set_column_width(self, col_letter: str, width: float) -> None: ...
    def set_column_width_range(self, col_range: str, width: float) -> None: ...
    def set_columns_width(self, col_letters: List[str], width: float) -> None: ...
    def set_column_widths(self, widths: dict[str, float]) -> None: ...
    def remove_style(self, range: str) -> None: ...

class Scanner:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    def get_sheets(self) -> List[str]: ...
    def open_editor(self, sheet_name: Optional[str] = None) -> Editor: ...
